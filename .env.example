# Skopiuj do .env i uzupelnij wlasnymi wartosciami.
# Plik .env jest w .gitignore i NIGDY nie trafia do repozytorium.

# --- Raspberry Pi: wysylka danych na serwer (raspberry/wyslij_dane.sh) ---
# Uwierzytelnianie kluczem SSH: ssh-copy-id $SERVER_USER@$SERVER_HOST
SERVER_USER=user
SERVER_HOST=10.0.0.1
SERVER_INBOX=~/dane_odbior_1
SNIFFER_OUT_DIR=/home/admin/sniffer/
RASPBERRY_ID=rpi2

# --- Serwer: migracja SQLite -> MySQL (server/migrate_to_mysql.py) ---
MYSQL_HOST=localhost
MYSQL_USER=zmien_mnie
MYSQL_PASSWORD=zmien_mnie
MYSQL_DATABASE=test
SOURCE_DIR=/home/user/dane_odbior_1/
ARCHIVE_DIR=/home/user/dane_odbior_1/archive
LOCK_FILE=/tmp/migrate_wifi.lock

# --- Serwer: aplikacja webowa (server/app.py) ---
# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=zmien_mnie
WYNIKI_DB=/home/user/algorytm/wyniki.db
